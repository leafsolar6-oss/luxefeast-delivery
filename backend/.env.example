# LuxFeast backend configuration
# ─────────────────────────────────────────────────────────────────
# NEON: create a project at https://neon.tech, copy the connection
# string from the dashboard and paste it here:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/luxefeast?sslmode=require

# Local development default:
DATABASE_URL=postgresql://luxefeast:luxefeast@localhost:5432/luxefeast

PORT=5000
JWT_SECRET=change-me-in-production
